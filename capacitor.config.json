{
  "appId": "com.app.kwdyzc",
  "appName": "كوديز Codeezy — ابنِ مواقعك با",
  "webDir": "www",
  "server": {
    "url": "https://codeezy.lovable.app/",
    "cleartext": false,
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0f172a",
    "webContentsDebuggingEnabled": false,
    "captureInput": true,
    "useLegacyBridge": false
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    },
    "CapacitorCookies": {
      "enabled": true
    },
    "SplashScreen": {
      "backgroundColor": "#0f172a",
      "launchAutoHide": true,
      "launchShowDuration": 1500,
      "androidScaleType": "FIT_CENTER",
      "showSpinner": false
    }
  }
}